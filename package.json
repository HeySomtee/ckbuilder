{
  "name": "ckb-learning",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly TypeScript replicas of CKB fundamentals while learning Nervos CKB",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm --prefix products/streak install",
    "week1": "ts-node src/week1/cell-model/demo.ts",
    "test:week1": "ts-node src/week1/cell-model/demo.ts",
    "test:week14": "npm --prefix products/streak run test:football",
    "test:week15": "npm --prefix products/streak run test:insights",
    "test:week16": "npm --prefix products/streak test",
    "test:week18": "node src/week18/contract-lab/scripts/run.cjs test",
    "devnet:week18": "node src/week18/contract-lab/scripts/run.cjs devnet",
    "evidence:week18": "node src/week18/contract-lab/scripts/evidence.cjs",
    "test:week19": "node src/week19/contract-lab/scripts/run.cjs test && node src/week19/contract-lab/scripts/test-accounting.cjs",
    "devnet:week19": "node src/week19/contract-lab/scripts/run.cjs devnet",
    "evidence:week19": "node src/week19/contract-lab/scripts/evidence.cjs",
    "test:week20": "node src/week20/contract-lab/scripts/run.cjs test && node src/week20/contract-lab/scripts/test-accounting.cjs && node --test src/week20/contract-lab/scripts/client.test.cjs",
    "devnet:week20": "node src/week20/contract-lab/scripts/run.cjs devnet",
    "testnet:week20": "node src/week20/contract-lab/scripts/testnet.cjs",
    "demo:week20": "node src/week20/contract-lab/scripts/serve.cjs",
    "evidence:week20": "node src/week20/contract-lab/scripts/evidence.cjs",
    "wallet": "ts-node src/week2/wallet/cli.ts",
    "week3": "ts-node src/week3/nft-faucet/server.ts",
    "week4": "ts-node src/week4/nft-dao/server.ts",
    "week5": "ts-node src/week5/scroll/server.ts",
    "streak": "npm --prefix products/streak start",
    "start": "npm run streak"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.12.5",
    "@ckb-ccc/spore": "^1.5.17"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
