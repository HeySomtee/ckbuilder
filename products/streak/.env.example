# Streak Terminal — environment variables
# Copy this to `.env` and fill in. The .env file is gitignored.

# --- World Cup live oracle (worldcup26.ir) ---
# Invent any email/password — server auto-registers on first boot
# and caches the returned JWT in data/db.json. Leave blank to use
# deterministic simulated results.
WC_API_EMAIL=
WC_API_PASSWORD=
# Optional display name used when registering:
# WC_API_NAME=Streak Terminal
# Optional: skip register/login and use a pre-existing JWT:
# WC_API_TOKEN=

# --- Server ---
# PORT=4100
