# Streak Terminal — environment variables
# Copy this to `.env` and fill in. The .env file is gitignored.

# --- World Cup live oracle (worldcup26.ir) ---
# Invent any email/password — server auto-registers on first boot
# and caches the returned JWT in data/db.json. Leave blank to use
# deterministic simulated results.
WC_API_EMAIL=
WC_API_PASSWORD=
# Optional display name used when registering:
# WC_API_NAME=Streak Terminal
# Optional: skip register/login and use a pre-existing JWT:
# WC_API_TOKEN=

# --- Server ---
# PORT=4100

# Local Five/Survivor data source. Restart the API and reload the page after changing.
# api = regular football data (default); test = isolated dummy rounds on localhost only.
# Test mode also requires STREAK_GAMES_TEST_ENABLED=1 and the separate test DB/wallet setup.
# Never set test on Render. Existing test reward workers can finish pending transfers.
STREAK_GAMES_DATA_MODE=api

# --- Relational store (Postgres) ---
# Replaces the single-jsonb-row Supabase store. Any Postgres works; Neon's free
# tier is the usual pick (https://neon.com/signup). Use the POOLED connection
# string — its host contains "-pooler".
# Create the schema and load an existing blob with:
#   node scripts/migrate-to-tables.cjs --from data/db.json --to "$DATABASE_URL"
#   node scripts/migrate-to-tables.cjs --from data/db.json --to "$DATABASE_URL" --apply
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Read-snapshot TTL. The old 1500ms default meant the 20s settle loop refetched
# constantly; with scoped table reads a longer TTL is cheap.
# STORE_READ_TTL_MS=5000
