# API-SPORTS / API-Football (server-side only; never expose this in browser code)
API_SPORTS_KEY=
MATCH_PROVIDER=football

# Premier League, La Liga, Bundesliga, Serie A, Ligue 1, Champions League
FOOTBALL_LEAGUE_IDS=39,140,78,135,61,2

# API-Football seasons use their starting year: 2026 means 2026/27.
# Omit this to let the provider infer the active European season.
# FOOTBALL_SEASON=2026

# Optional quota/caching controls
FOOTBALL_FIXTURE_PAST_DAYS=2
FOOTBALL_FIXTURE_FUTURE_DAYS=21
FOOTBALL_LIVE_POLL_SECONDS=20
FOOTBALL_FINAL_CONFIRMATIONS=2
FOOTBALL_SCHEDULE_REFRESH_MINUTES=360
FOOTBALL_INSIGHT_PREFETCH_MINUTES=90
FOOTBALL_INSIGHT_PREFETCH_BATCH=4
